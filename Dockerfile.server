FROM golang:1.25 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /portfolio-server ./cmd/server

FROM gcr.io/distroless/static-debian12

COPY --from=builder /portfolio-server /portfolio-server
COPY migrations /migrations

ENV MIGRATIONS_PATH=file:///migrations

EXPOSE 8080

ENTRYPOINT ["/portfolio-server"]
