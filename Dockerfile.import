FROM golang:1.25 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /portfolio-import ./cmd/import

FROM gcr.io/distroless/static-debian12

COPY --from=builder /portfolio-import /portfolio-import
COPY migrations /migrations

ENV MIGRATIONS_PATH=file:///migrations

# Mount point for CSV files to import
VOLUME ["/data"]

ENTRYPOINT ["/portfolio-import"]
